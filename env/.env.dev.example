# Copy this file to `env/.env.dev` and fill in real values. Never commit the real file.
# Select which env loads at runtime with ENVIRONMENT=dev|staging|prod|ci (defaults to dev).

# ── URLs (single source of truth: process.env) ──
# BASE_URL is the app ROOT only — no path segment. Put paths in enums/util/routes.ts and
# navigate to them, so a goto('/') never drops part of the URL.
#   ✅ BASE_URL=https://demo.playwright.dev        (then navigate to '/todomvc')
#   ❌ BASE_URL=https://demo.playwright.dev/todomvc
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# ── Credentials (never hardcode in tests) ──
TEST_USER_EMAIL=test_user@example.com
TEST_USER_PASSWORD=

# ── Auth storage state produced by auth.setup.ts ──
STORAGE_STATE=.auth/user.json
