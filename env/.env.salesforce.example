# ─────────────────────────────────────────────────────────────────────────────────────────────
# Salesforce environment — copy this BLOCK into env/.env.<environment> and fill in.
#
# NEVER commit the filled-in file, and never commit the private key. `env/.env.*` is gitignored;
# only `*.example` is tracked. A Salesforce access token IS a live session id.
#
# ── TESTING MORE THAN ONE ENVIRONMENT (dev, staging, …)? ────────────────────────────────────────
# This file is a single template, not one-per-environment, because the VARIABLE NAMES are the same
# everywhere — only the VALUES differ (a different org, a different login URL, a different sandbox
# suffix). So paste this whole block into EACH env/.env.<environment> file you use, and fill in that
# environment's real values. `ENVIRONMENT=staging` then picks up the right file automatically —
# same mechanism the generic scaffold already uses for BASE_URL/API_URL above.
#
# What follows is already handled per-environment with no extra setup from you: storage state
# (`.auth/<environment>/sf-<persona>.json`) and the generated `describe` snapshot (keyed by
# environment inside one file — `npm run sf:schemas` merges rather than overwrites). See
# docs/salesforce/TEST-ARCHITECTURE.md §"Multi-environment" for what is NOT automatic (the
# hand-authored contract and persona/permission-set expectations assume one environment's model).
#
# See the `salesforce-auth` skill for the one-time Connected App setup.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── Hosts ────────────────────────────────────────────────────────────────────────────────────
# BASE_URL is your LIGHTNING host — the app root, no path segment (a path here breaks goto('/')).
BASE_URL=https://your-org--uat.sandbox.lightning.force.com

# OAuth login host. Sandboxes: https://test.salesforce.com  Production/Dev: https://login.salesforce.com
# This is the token endpoint AND the JWT `aud` claim. Getting it wrong is the most common cause of
# a bare `invalid_grant` with no further detail.
SF_LOGIN_URL=https://test.salesforce.com

# NOTE: the API instance host is NOT set here — it comes from the token response (`instance_url`)
# at runtime, because sandbox refreshes and org migrations change it.

# ── API version ──────────────────────────────────────────────────────────────────────────────
# Pin it. `tests/salesforce/metadata-contract.spec.ts` asserts the org still supports this value.
SF_API_VERSION=v62.0

# ── Auth strategy: jwt | sfdx | password ─────────────────────────────────────────────────────
# Defaults to jwt in CI, sfdx locally. Only `jwt` supports multiple personas.
SF_AUTH_STRATEGY=jwt

# --- jwt (recommended; MFA-exempt by design) ---
# Connected App consumer key.
SF_CLIENT_ID=
# Supply EITHER the PEM contents (CI secret — literal \n is un-escaped for you) ...
SF_JWT_PRIVATE_KEY=
# ... OR a path to the key file (local dev). Never commit either.
SF_JWT_KEY_PATH=

# --- sfdx (local dev only; single persona) ---
# `sf` CLI alias or username. Requires `sf org login web` first.
SF_TARGET_ORG=

# --- password (LAST RESORT; needs MFA disabled — see the skill) ---
SF_CLIENT_SECRET=

# ── Personas ─────────────────────────────────────────────────────────────────────────────────
# One username per persona in test-data/salesforce/personas.ts. The env var name is the persona
# key in UPPER_SNAKE_CASE (standardUser → SF_USERNAME_STANDARD_USER).
#
# Each of these users needs the Connected App assigned to its profile or a permission set it
# holds — the step everyone forgets. Without it: `invalid_grant: user hasn't approved this consumer`.
#
# The personas form a lattice: each differs from its neighbour on ONE permission axis, so a failing
# matrix cell tells you which axis broke. See docs/salesforce/TEST-ARCHITECTURE.md §5.

# ARRANGE/TEARDOWN identity. Modify All Data, so cleanup is never blocked. Never asserts.
SF_USERNAME_SYS_ADMIN=

# Positive control — full access but NOT an admin, so it can't pass via Modify All Data.
SF_USERNAME_FULL_ACCESS=

# The default UI subject: create/read/edit, no delete. What a realistic user has.
SF_USERNAME_STANDARD_USER=

# Same CRUD as standardUser, some fields hidden → isolates FLS.
SF_USERNAME_LIMITED_FIELDS=

# Read only, all fields visible → isolates CRUD.
SF_USERNAME_READ_ONLY=

# No object access → proves deny assertions can actually fail.
SF_USERNAME_NO_ACCESS=

# Role-hierarchy pair → isolates SHARING (identical CRUD/FLS to each other).
SF_USERNAME_MANAGER=
SF_USERNAME_SUBORDINATE=

# API-only identity (uiCapable: false → gets no browser storageState).
SF_USERNAME_INTEGRATION_USER=

# Passwords are only needed for SF_AUTH_STRATEGY=password.
# SF_PASSWORD_SYS_ADMIN=

# ── Identity split (see docs/salesforce/TEST-ARCHITECTURE.md §1) ──────────────────────────────
# ARRANGE/TEARDOWN identity — must be marked `privileged: true` in personas.ts. Record creation
# and deletion go through this one.
SF_ADMIN_PERSONA=sysAdmin

# SUBJECT identity — the persona UI tests run as and `org` asserts with.
# ⚠️ Do NOT set this to an admin. A UI test running as System Admin exercises a screen no real user
# sees, and Modify All Data bypasses sharing and FLS, hiding the bugs you meant to catch.
SF_DEFAULT_PERSONA=standardUser

# Appended to every persona username. A sandbox refresh renames users by appending the sandbox
# name (qa.user@acme.com → qa.user@acme.com.uat), so keeping this env-driven makes a refresh a
# one-line change instead of editing every persona.
SF_USERNAME_SUFFIX=

# ── Test data ────────────────────────────────────────────────────────────────────────────────
# Prefix on every record the suite creates, so orphans can be found and purged with one list-view
# filter. They WILL accumulate in a shared sandbox.
SF_TEST_PREFIX=PWT-

# Abort a run when remaining daily API requests fall below this fraction of Max. The daily limit is
# org-wide and shared with production integrations — exhausting it has blast radius beyond your tests.
SF_API_LIMIT_THRESHOLD=0.1
