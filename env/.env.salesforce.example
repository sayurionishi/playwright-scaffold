# ─────────────────────────────────────────────────────────────────────────────────────────────
# Salesforce environment — copy to env/.env.<environment> and fill in.
#
# NEVER commit the filled-in file, and never commit the private key. `env/.env.*` is gitignored;
# only `*.example` is tracked. A Salesforce access token IS a live session id.
#
# See the `salesforce-auth` skill for the one-time Connected App setup.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── Hosts ────────────────────────────────────────────────────────────────────────────────────
# BASE_URL is your LIGHTNING host — the app root, no path segment (a path here breaks goto('/')).
BASE_URL=https://your-org--uat.sandbox.lightning.force.com

# OAuth login host. Sandboxes: https://test.salesforce.com  Production/Dev: https://login.salesforce.com
# This is the token endpoint AND the JWT `aud` claim. Getting it wrong is the most common cause of
# a bare `invalid_grant` with no further detail.
SF_LOGIN_URL=https://test.salesforce.com

# NOTE: the API instance host is NOT set here — it comes from the token response (`instance_url`)
# at runtime, because sandbox refreshes and org migrations change it.

# ── API version ──────────────────────────────────────────────────────────────────────────────
# Pin it. `tests/salesforce/metadata-contract.spec.ts` asserts the org still supports this value.
SF_API_VERSION=v62.0

# ── Auth strategy: jwt | sfdx | password ─────────────────────────────────────────────────────
# Defaults to jwt in CI, sfdx locally. Only `jwt` supports multiple personas.
SF_AUTH_STRATEGY=jwt

# --- jwt (recommended; MFA-exempt by design) ---
# Connected App consumer key.
SF_CLIENT_ID=
# Supply EITHER the PEM contents (CI secret — literal \n is un-escaped for you) ...
SF_JWT_PRIVATE_KEY=
# ... OR a path to the key file (local dev). Never commit either.
SF_JWT_KEY_PATH=

# --- sfdx (local dev only; single persona) ---
# `sf` CLI alias or username. Requires `sf org login web` first.
SF_TARGET_ORG=

# --- password (LAST RESORT; needs MFA disabled — see the skill) ---
SF_CLIENT_SECRET=

# ── Personas ─────────────────────────────────────────────────────────────────────────────────
# One username per persona in test-data/salesforce/personas.ts. The env var name is the persona
# key in UPPER_SNAKE_CASE (salesRep → SF_USERNAME_SALES_REP).
#
# Each of these users needs the Connected App assigned to its profile or a permission set it
# holds — the step everyone forgets. Without it: `invalid_grant: user hasn't approved this consumer`.
SF_USERNAME_ADMIN=
SF_USERNAME_SALES_REP=
SF_USERNAME_SALES_MANAGER=
SF_USERNAME_READ_ONLY=

# Passwords are only needed for SF_AUTH_STRATEGY=password.
# SF_PASSWORD_ADMIN=

# Which persona the UI projects run as by default.
SF_DEFAULT_PERSONA=admin

# Appended to every persona username. A sandbox refresh renames users by appending the sandbox
# name (qa.user@acme.com → qa.user@acme.com.uat), so keeping this env-driven makes a refresh a
# one-line change instead of editing every persona.
SF_USERNAME_SUFFIX=

# ── Test data ────────────────────────────────────────────────────────────────────────────────
# Prefix on every record the suite creates, so orphans can be found and purged with one list-view
# filter. They WILL accumulate in a shared sandbox.
SF_TEST_PREFIX=PWT-

# Abort a run when remaining daily API requests fall below this fraction of Max. The daily limit is
# org-wide and shared with production integrations — exhausting it has blast radius beyond your tests.
SF_API_LIMIT_THRESHOLD=0.1
